{
  "name": "icelauch",
  "version": "1.1.3",
  "description": "Trình quản lý game và giải trí cá nhân cho Windows 10",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "node scripts/launch.cjs",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:build:android": "npm run build && cap sync android",
    "dist": "tsc && vite build && electron-builder",
    "dist:win": "tsc && vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.icelauch.app",
    "productName": "Icelauch",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NguyenDacTung",
        "repo": "Icelauch"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "7z",
        "to": "7z"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "keywords": [
    "game-launcher",
    "media-player",
    "electron",
    "react"
  ],
  "author": "Icelauch Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
